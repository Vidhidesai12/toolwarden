{
  "name": "toolwarden",
  "version": "1.0.0",
  "private": true,
  "description": "ToolWarden: a security gateway and dashboard for MCP tool calls. Per-client policies, tool pinning against tool poisoning, secret masking and a hash-chained audit log.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev:web": "npm --prefix web run dev",
    "demo:servers": "node dist/demo/servers.js",
    "demo:rugpull": "node dist/demo/rugpull.js",
    "demo": "node scripts/demo.mjs",
    "pin": "node --env-file-if-exists=.env dist/pin.js",
    "verify-audit": "node scripts/verify-audit.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && npm --prefix web run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
